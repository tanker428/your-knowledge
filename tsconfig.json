{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "strict": false
  },
  "include": ["src/**/*.js", "tests/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist", "sw.js"]
}
