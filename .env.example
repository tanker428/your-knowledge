# Your Knowledge — environment variable names only. NEVER put real values in this file.
#
# The GitHub Pages build ships NO secrets. The browser bundle must never receive
# an API key, a database credential, or any bearer token. Everything below is for a
# FUTURE, separately deployed backend (see docs/ARCHITECTURE.md "AnalysisProvider").
#
# If you ever add a backend, keep these in the backend's own environment
# (GitHub Actions secrets / hosting provider secrets) — not here, not in the client.

# Base URL of the future analysis backend that returns Observation candidates.
# The browser only ever learns this URL, never the credentials behind it.
ANALYSIS_API_BASE_URL=

# Server-side only. Held by the backend, never sent to the browser.
ANALYSIS_API_KEY=
